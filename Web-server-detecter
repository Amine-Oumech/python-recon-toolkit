import socket
import sys
def usage():
 print("Error:use something similar to : sudo python3 scanner9.py ip port")
 print("check this link for more explaination:https://Amine-omiche.com/projects/scanner9.py")
if len(sys.argv) != 3:
    usage()
    sys.exit()
target=sys.argv[1]
port=int(sys.argv[2])
s=socket.socket(socket.AF_INET,socket.SOCK_STREAM)
s.settimeout(2.7)
response=s.connect_ex((target,port))
try:
   if response == 0:
      print(f"The port {port} is open")
      request=("GET / HTTP/1.1 \r\n "
               f"Host:{target}\r\n"
               "Connection:close\r\n"
               "\r\n")
      data_sent=s.sendall(request.encode())
      decoding=s.recv(4096).decode(errors="ignore")
      for line in decoding.split("\r\n"):
          if line.lower().startswith("server"):
             server=line.split(":",1)[1].strip()
             print(f"Server:{server}")
   elif response != 0:
     print(f"The port {port} is closed")
     sys.exit()
except socket.timeout:
   print("Connection timed out")
except OSError:
   print("oops we have encountered a network error")
except KeyboardInterrupt:
   print("Program stopped")
